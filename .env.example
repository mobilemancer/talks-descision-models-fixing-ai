# Copy to .env and fill in. Never commit .env.

# --- TypeSafe Jev ---
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# TYPESAFE_URL=https://api.typesafe.ai/v1/systemone

# --- Microsoft Foundry ---
# Resource endpoint from the deployment details page, e.g. https://my-resource.services.ai.azure.com
FOUNDRY_ENDPOINT=
FOUNDRY_API_KEY=
# Deployment name of Microsoft-Decision-1.1 (not the model name)
FOUNDRY_DECISION_DEPLOYMENT=Microsoft-Decision-1.1
# Deployment name of any chat model in the same resource (the "LLM" in the demos)
FOUNDRY_CHAT_DEPLOYMENT=

# Optional full-URL overrides if your resource uses a different path
# FOUNDRY_DECISION_URL=https://my-resource.services.ai.azure.com/providers/microsoft/v1/systemone
# FOUNDRY_CHAT_URL=https://my-resource.services.ai.azure.com/openai/v1/chat/completions

# Thresholds used by the confidence policy in demo 2
ACT_THRESHOLD=0.9
LOG_THRESHOLD=0.7
